# Multi-stage frontend build for CI / machines with Node Hub access.
# Local `make up` uses the prebuilt dist + nginx image (see frontend/Dockerfile).
FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
