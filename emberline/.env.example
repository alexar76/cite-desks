APP_ENV=development
# live = merchant (USDC checkout when PAY_MODE and treasury are set).
# demo = public reference host: checkout closed, sample briefs, watch scheduler off.
DESK_MODE=live
PUBLIC_URL=http://localhost:8080
# Production: PUBLIC_URL=https://emberlinedesk.com
DATABASE_URL=postgresql://emberline:emberline@localhost:5432/emberline
JWT_SECRET=replace-me-with-a-long-random-string
HUB_MODE=fixture
HUB_URL=https://modelmarket.dev
HUB_API_KEY=
HUB_PAYMENT_CHANNEL=
HUB_PAYMENT_CHANNEL_SECRET=
SEED_DEMO=true
SCHEDULER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Production: CORS_ORIGINS=https://emberlinedesk.com
PAY_MINT_SECRET=
PAY_MODE=fixture
# Optional extras, comma-separated. Built-in Base backups always follow:
# mainnet.base.org, publicnode, 1rpc, drpc, tenderly.
PAY_BASE_RPC_URL=
PAY_BASE_ADDRESS=0x1111111111111111111111111111111111111111
PAY_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PAY_BASE_CHAIN_ID=8453
PAY_BASE_CONFIRMATIONS=2
# A transfer that lands after the quote lapses still settles for this long.
PAY_LATE_GRACE_HOURS=24
LOGIN_RATE_LIMIT=20
COOKIE_SECURE=false
# Optional. Empty = same as PAY_MINT_SECRET. Unlocks /ops.
OPS_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:desk@emberlinedesk.com
POSTGRES_PASSWORD=emberline
