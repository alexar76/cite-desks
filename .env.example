# Shared env for sibling desks. Copy next to the desk you deploy.
# Emberline keeps emberline/.env.example.

APP_ENV=development
# live = merchant. demo = public reference (checkout closed; not PAY_MODE=fixture).
DESK_MODE=live
HUB_MODE=fixture
HUB_URL=https://modelmarket.dev
HUB_API_KEY=
# Use a prepaid Hub channel when the selected Hub does not enable credit accounts.
# Set both channel values, or neither. A channel takes precedence over HUB_API_KEY.
HUB_PAYMENT_CHANNEL=
HUB_PAYMENT_CHANNEL_SECRET=
JWT_SECRET=cite-desk-dev-secret-change-me
POSTGRES_PASSWORD=change-me
SEED_DEMO=true
# fixture = demo checkout on an in-process chain (never allowed in production).
# live    = real USDC on Base; the settlement poll issues desk keys with nobody watching.
PAY_MODE=fixture
PAY_MINT_SECRET=
# In live mode this MUST be a treasury you own. The placeholder below is refused at boot:
# a buyer sending real USDC to an unowned address is not a recoverable mistake.
PAY_BASE_ADDRESS=0x1111111111111111111111111111111111111111
PAY_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PAY_BASE_CHAIN_ID=8453
PAY_BASE_CONFIRMATIONS=2
# Optional extras, comma-separated. Built-in public Base endpoints always follow:
# mainnet.base.org, publicnode, 1rpc, drpc, tenderly.
PAY_BASE_RPC_URL=
# How often the treasury is scanned. Nothing else turns a transfer into a desk key.
PAY_SCAN_INTERVAL_SECONDS=20
PAY_INVOICE_TTL_MINUTES=45
# A transfer that lands after the quote lapses still settles for this long.
PAY_LATE_GRACE_HOURS=24
